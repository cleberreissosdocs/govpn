#!/bin/bash
# postinstall — runs as root, right after the installer (Installer.app)
# copies govpn-client-gui.app into /Applications. Sets up BOTH pieces
# of the privilege-separated design (see client-gui/main_darwin.go):
#
# 1. A root LaunchDaemon (system-wide, starts at boot, no login
#    needed) running `govpn-client daemon` — this is the ONLY place
#    a password is asked, and only because you're running this
#    installer right now. From here on it never prompts again.
# 2. A per-user LaunchAgent for the unprivileged tray icon (needs the
#    actual logged-in user's GUI session — a root process can't show a
#    menu-bar item).
# 3. The shared folder both sides talk through, made group-writable so
#    the (unprivileged) tray app and any standard user account can
#    edit config.yml / request reconnect-disconnect without sudo.

set -euo pipefail

APP_PATH="/Applications/govpn-client-gui.app"
SHARED_DIR="/Library/Application Support/govpn"
DAEMON_PLIST_PATH="/Library/LaunchDaemons/com.cleberreissosdocs.govpn.client-daemon.plist"
AGENT_PLIST_NAME="com.cleberreissosdocs.govpn.client-gui.plist"

# Gatekeeper quarantine: Installer.app-driven installs usually don't
# propagate it to the payload, but clear it defensively anyway so the
# app never shows the "unidentified developer" dialog after install
# (the .pkg itself still needs the one-time Gatekeeper bypass to open,
# documented in the README — we have no paid Apple Developer cert to
# sign/notarize this with).
xattr -dr com.apple.quarantine "$APP_PATH" 2>/dev/null || true

echo "==> Shared folder: $SHARED_DIR (group-writable, no sudo needed day to day)"
mkdir -p "$SHARED_DIR"
chgrp staff "$SHARED_DIR"
chmod 2775 "$SHARED_DIR"   # setgid: files created inside inherit group "staff"
if [ ! -f "$SHARED_DIR/config.yml" ]; then
	cat > "$SHARED_DIR/config.yml" <<'CFG'
server: "http://SEU_SERVIDOR:28443"
authkey: "SUA_AUTH_KEY"
hostname: ""
iface: "utun"
poll_interval: "10s"
CFG
fi
chmod 664 "$SHARED_DIR/config.yml"
touch "$SHARED_DIR/daemon.log"
chmod 664 "$SHARED_DIR/daemon.log"

echo "==> Root LaunchDaemon (the only step that needs your password — this install)"
cat > "$DAEMON_PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cleberreissosdocs.govpn.client-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>$APP_PATH/Contents/MacOS/govpn-client</string>
		<string>daemon</string>
		<string>--config</string>
		<string>$SHARED_DIR/config.yml</string>
		<string>--status-file</string>
		<string>$SHARED_DIR/status.json</string>
		<string>--cmd-dir</string>
		<string>$SHARED_DIR</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- Root's \$HOME (/var/root) is not set in a LaunchDaemon's
		     minimal environment at all, and os.UserHomeDir() in Go
		     needs \$HOME on Unix with no fallback. Without this,
		     core.StateDir() fails, state.json (the device's identity)
		     never gets saved, and EVERY restart/retry registers as a
		     brand-new device using the SAME auth key, which is
		     single-use, so it works once then fails forever with
		     "auth key already used". Pin it to the shared folder
		     instead so state persists exactly like config/status. -->
		<key>GOVPN_STATE_DIR</key>
		<string>$SHARED_DIR</string>
	</dict>
	<key>StandardOutPath</key>
	<string>$SHARED_DIR/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>$SHARED_DIR/daemon.log</string>
</dict>
</plist>
PLIST
chown root:wheel "$DAEMON_PLIST_PATH"
chmod 644 "$DAEMON_PLIST_PATH"
launchctl bootout system "$DAEMON_PLIST_PATH" 2>/dev/null || true
launchctl bootstrap system "$DAEMON_PLIST_PATH" 2>/dev/null || launchctl load "$DAEMON_PLIST_PATH" 2>/dev/null || true

# ---- per-user tray icon (unprivileged) ----

CONSOLE_USER="$(stat -f%Su /dev/console)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
	# Nobody logged in graphically (e.g. remote/unattended install) —
	# the daemon above is already running regardless; the tray icon
	# just won't show until someone installs the LaunchAgent manually
	# or re-runs this installer while logged in.
	exit 0
fi
CONSOLE_UID="$(id -u "$CONSOLE_USER")"
USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')"
AGENTS_DIR="$USER_HOME/Library/LaunchAgents"
AGENT_PLIST_PATH="$AGENTS_DIR/$AGENT_PLIST_NAME"

echo "==> Tray icon LaunchAgent for $CONSOLE_USER (unprivileged, no more prompts)"
mkdir -p "$AGENTS_DIR"
cat > "$AGENT_PLIST_PATH" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cleberreissosdocs.govpn.client-gui</string>
	<key>ProgramArguments</key>
	<array>
		<string>$APP_PATH/Contents/MacOS/govpn-client-gui</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/govpn-client-gui.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/govpn-client-gui.log</string>
</dict>
</plist>
PLIST
chown "$CONSOLE_USER":staff "$AGENT_PLIST_PATH"
chmod 644 "$AGENT_PLIST_PATH"

launchctl asuser "$CONSOLE_UID" launchctl unload "$AGENT_PLIST_PATH" 2>/dev/null || true
launchctl asuser "$CONSOLE_UID" launchctl load "$AGENT_PLIST_PATH" 2>/dev/null || true

exit 0
